# Required
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5435/el7al_db?schema=public"
JWT_SECRET="at-least-16-random-characters"   # required when NODE_ENV=production
NODE_ENV="development"

# Production only
REDIS_PASSWORD=""                              # required when NODE_ENV=production
CORS_ORIGINS="https://app.example.com"         # comma-separated browser origins; native apps are unaffected

# Email (leave EMAIL_PROVIDER=mock to print codes in the server log)
EMAIL_PROVIDER="mock"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
FROM_EMAIL=""
