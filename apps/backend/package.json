    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@prisma/client": "^5.14.0",
    "argon2": "^0.40.1",
    "axios": "^1.20.0",
    "bullmq": "^5.7.14",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.7",
    "ioredis": "^5.4.1",
    "minio": "^7.1.3",
    "nodemailer": "^10.1.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.2",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^8.0.1",
    "prisma": "^5.14.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  }
