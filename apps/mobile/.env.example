# Backend API base URL including /api/v1. Must be https:// for production builds.
# Leave unset in development to auto-detect the Expo dev host (http://<lan-ip>:4000/api/v1).
EXPO_PUBLIC_API_URL=https://api.example.com/api/v1
# Sentry DSN for crash reporting in release builds (optional; empty = off). Set it in the EAS build profile.
EXPO_PUBLIC_SENTRY_DSN=
# El 7al bank account artisans transfer commissions to (shown on "Payer El 7al"). The row is hidden when empty.
EXPO_PUBLIC_EL7AL_RIB=
