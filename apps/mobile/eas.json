{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.el7al.tn/api/v1",
        "EXPO_PUBLIC_EL7AL_RIB": "TN59 0000 0000 0000 0000 0000",
        "EXPO_PUBLIC_CLIENT_ENABLED": "false",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.el7al.tn/api/v1",
        "EXPO_PUBLIC_EL7AL_RIB": "TN59 0000 0000 0000 0000 0000",
        "EXPO_PUBLIC_CLIENT_ENABLED": "false",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
