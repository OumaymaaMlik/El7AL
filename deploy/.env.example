# Copy to deploy/.env and fill in. This file is never committed.

# Public names (three DNS A records pointing at the VPS)
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
FILES_DOMAIN=files.example.com

# Secrets: generate each with  openssl rand -base64 32
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
MINIO_ROOT_USER=el7a_files
MINIO_ROOT_PASSWORD=

# First admin account (created once, only if no admin exists). Password: 12+ characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# E-mail for verification and password-reset codes. EMAIL_PROVIDER=gmail or smtp (mock only prints the code).
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL="El 7al <no-reply@example.com>"

# Optional: stop offering missions to an artisan whose unpaid commissions exceed this many TND (unset = no limit)
# MAX_PROVIDER_DEBT_TND=300
