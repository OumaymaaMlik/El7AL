# One reverse proxy, three public names. Certificates are issued and renewed automatically.
# {$APP_DOMAIN}, {$API_DOMAIN}, {$FILES_DOMAIN} come from deploy/.env

www.{$APP_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} permanent
}

{$APP_DOMAIN} {
	root * /srv/web
	encode zstd gzip
	try_files {path} /index.html
	file_server

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
		Strict-Transport-Security "max-age=31536000"
		# Report-only first: check the browser console, then rename to Content-Security-Policy.
		Content-Security-Policy-Report-Only "default-src 'self'; img-src 'self' data: blob: https://*.tile.openstreetmap.org https://{$FILES_DOMAIN}; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://{$API_DOMAIN} wss://{$API_DOMAIN}; frame-ancestors 'none'"
	}
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
}

{$API_DOMAIN} {
	# Monitoring and API docs stay private (reach them over SSH or add basic auth).
	@private path /metrics* /docs*
	respond @private 404

	encode zstd gzip
	reverse_proxy backend:4000 {
		# WebSocket upgrades are handled automatically. Keep real client IPs for rate limiting.
		header_up X-Forwarded-For {remote_host}
	}
	header Strict-Transport-Security "max-age=31536000"
}

{$FILES_DOMAIN} {
	# Uploaded files. Avatars are public; documents and receipts need a signed link (the Host header
	# must reach MinIO unchanged, which is Caddy's default).
	reverse_proxy minio:9000
	header Strict-Transport-Security "max-age=31536000"
}
